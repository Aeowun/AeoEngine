entity ThirdPersonController {
    player = nil
    camera = nil
    input = nil

    speed = 5.0
    jump_impulse = 6.5

    fn constructor(player_object, camera_object, input_system) {
        player = player_object
        camera = camera_object
        input = input_system
    }

    fn update(dt) {
        if player == nil { return }

        const move_in = input.get_move_vector()
        const jump_pressed = input.is_jump_pressed()

        const basis = camera.get_horizontal_basis()
        const forward = basis[0]
        const right = basis[1]

        const move_dir = [
            forward[0] * move_in[1] + right[0] * move_in[0],
            forward[2] * move_in[1] + right[2] * move_in[0]
        ]

        if move_in[0] != 0 || move_in[1] != 0 {
            player.set_horizontal_velocity(move_dir[0] * speed, move_dir[1] * speed)
            player.set_facing_direction(move_dir[0], move_dir[1])
            player.select_animation("Walk")
        } else {
            player.set_horizontal_velocity(0, 0)
            player.select_animation("Idle")
        }

        if jump_pressed && player.is_grounded() {
            player.apply_vertical_impulse(jump_impulse)
        }
    }
}
