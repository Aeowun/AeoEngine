on run_test() {
    debug.log("[TEST] test_handles START")
    ok: bool = true

    const temp = cell.new("Block")
    if temp == nil {
        ok = false
    } else {
        const id = temp.id
        if !cell.exists(id) { ok = false }

        cell.delete(temp)

        if cell.exists(id) { ok = false }
    }

    if ok {
        debug.log("[TEST] test_handles PASS")
    } else {
        debug.log("[TEST] test_handles FAIL")
    }

    test.complete("handles", ok)
}
