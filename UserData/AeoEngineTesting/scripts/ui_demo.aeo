const panel = ui.new("Panel")
const title = ui.new("Text")
const button = ui.new("Button")

panel.position = [100, 100]
panel.size = [400, 200]

title.text = "Hello World"
title.position = [120, 120]

button.text = "Close"
button.position = [120, 180]

button.on_click = fn() {
    debug.log("clicked")

    ui.delete(button)
}
