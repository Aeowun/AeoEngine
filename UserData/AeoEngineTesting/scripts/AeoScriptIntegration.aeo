entity AeoScriptIntegration {
finished: bool = false
update_seen: bool = false
update_ticks: number = 0
summary_reported: bool = false
wait_test_started: bool = false
wait_test_finished: bool = false
fn approx(a, b, epsilon) {
    const difference = math.abs(a - b)

    if difference <= epsilon {
        return true
    }

    return false
}

fn check(condition, label) {
    if condition {
        debug.log("PASS", label)
    } else {
        debug.log("FAIL", label)
    }
}

fn double(value) {
    return value * 2
}

fn test_core_language() {
    const a: number = 5
    b: number = 7

    b += 3

    check(a == 5, "number variable")
    check(b == 10, "compound assignment")
    check(double(4) == 8, "function call and return")

    if b > a {
        check(true, "if condition")
    } else {
        check(false, "if/else")
    }

    total: number = 0

    for value in [1, 2, 3] {
        total += value
    }

    check(total == 6, "for loop")

    i: number = 0

    while i < 4 {
        i += 1
    }

    check(i == 4, "while loop")

    const missing = nil

    check(missing == nil, "nil value")
}

fn test_maps() {
    const values = {}

    values["name"] = "AeoScript"
    values[1] = "numeric key"

    check(values["name"] == "AeoScript", "map string key")
    check(values[1] == "numeric key", "map numeric key")
    check(values["1"] == nil, "numeric and string map keys are distinct")
    check(values["missing"] == nil, "missing map key returns nil")

    values["name"] = nil

    check(values["name"] == nil, "nil deletes map key")

    const nested: basket = [10]

    values["basket"] = nested

    nested[0] = 42

    check(
        values["basket"][0] == 42,
        "map and basket reference semantics"
    )

    values["basket"][0] = 99

    check(
        nested[0] == 99,
        "nested mutation persists through aliases"
    )
}

fn test_baskets() {
    b: basket = [3, 1, 2]

    check(b.len() == 3, "basket len")

    b.sort()

    check(b[0] == 1, "basket sort first")
    check(b[1] == 2, "basket sort second")
    check(b[2] == 3, "basket sort third")

    b.insert(0, 10)

    check(b[0] == 10, "basket positional insert")
    check(b.len() == 4, "basket insert length")

    const removed = b.remove(0)

    check(removed == 10, "basket remove")
    check(b.len() == 3, "basket remove length")

    const found = b.find(2)

    check(found == 1, "basket find")

    created: basket = basket.create(3, 5)

    check(created.len() == 3, "basket create length")
    check(created[0] == 5, "basket create value")
    check(created[2] == 5, "basket create repeated value")

    empty_created: basket = basket.create(2)

    check(empty_created.len() == 2, "basket create nil length")
    check(empty_created[0] == nil, "basket create defaults to nil")

    moved: basket = [0, 1, 2, 3]

    basket.move(moved, 1, 2, 3)

    check(moved.len() == 5, "basket move length")
    check(moved[0] == 0, "basket move original first")
    check(moved[1] == 1, "basket move source preserved")
    check(moved[2] == 2, "basket move source preserved second")
    check(moved[3] == 1, "basket move copied first")
    check(moved[4] == 2, "basket move copied second")

    const joined = moved.concat(",")

    check(joined == "0,1,2,1,2", "basket concat")

    const clone = basket.clone(moved)

    clone[0] = 99

    check(moved[0] == 0, "basket clone keeps original")
    check(clone[0] == 99, "basket clone is separate outer basket")

    alias: basket = [1, 2, 3]
    const alias_copy = alias

    basket.clear(alias)

    check(alias.len() == 0, "basket clear")
    check(alias_copy.len() == 0, "basket clear through alias")

    frozen: basket = [7, 8]

    frozen.freeze()

    check(frozen.len() == 2, "basket freeze preserves contents")
    check(frozen[0] == 7, "basket freeze preserves values")

    nested_basket: basket = [[1, 2]]

    nested_basket[0][1] = 9

    check(
        nested_basket[0][1] == 9,
        "nested basket mutation"
    )
}

fn test_math() {
    check(math.abs(-12.5) == 12.5, "math.abs")
    check(math.min(9, 2) == 2, "math.min")
    check(math.max(9, 2) == 9, "math.max")
    check(math.floor(3.9) == 3, "math.floor")
    check(math.ceil(3.1) == 4, "math.ceil")
    check(math.round(3.6) == 4, "math.round")
    check(math.sqrt(81) == 9, "math.sqrt")
    check(math.pow(2, 5) == 32, "math.pow")

    const sine = math.sin(math.deg_to_rad(90))

    check(
        approx(sine, 1, 0.0001),
        "math.sin"
    )

    const cosine = math.cos(math.deg_to_rad(180))

    check(
        approx(cosine, -1, 0.0001),
        "math.cos"
    )

    check(math.tan(0) == 0, "math.tan")
    check(math.clamp(15, 0, 10) == 10, "math.clamp upper")
    check(math.clamp(-5, 0, 10) == 0, "math.clamp lower")
    check(math.lerp(10, 20, 0.5) == 15, "math.lerp")

    const radians = math.deg_to_rad(180)

    check(
        approx(radians, 3.14159265359, 0.000001),
        "math.deg_to_rad"
    )

    const degrees = math.rad_to_deg(radians)

    check(
        approx(degrees, 180, 0.000001),
        "math.rad_to_deg"
    )
}

fn test_strings() {
    check(string.len("hello") == 5, "string.len")
    check(string.lower("HeLLo") == "hello", "string.lower")
    check(string.upper("HeLLo") == "HELLO", "string.upper")
    check(string.reverse("abc") == "cba", "string.reverse")

    check(
        string.len("é") == 1,
        "unicode scalar string length"
    )

    const characters: basket = string.split("é")

    check(
        characters.len() == 1,
        "unicode scalar string split length"
    )

    check(
        characters[0] == "é",
        "unicode scalar string split value"
    )

    parts: basket = string.split("one,two,three", ",")

    check(parts.len() == 3, "string.split length")
    check(parts[0] == "one", "string.split first")
    check(parts[1] == "two", "string.split second")
    check(parts[2] == "three", "string.split third")

    const ascii_characters: basket = string.split("abc")

    check(
        ascii_characters.len() == 3,
        "string.split characters length"
    )

    check(
        ascii_characters[0] == "a",
        "string.split first character"
    )

    check(
        ascii_characters[2] == "c",
        "string.split last character"
    )
}

fn test_blocks() {
    const matches1 = find("AeoScriptTestBlock1")
    const matches2 = find("AeoScriptTestBlock2")
    const matches3 = find("AeoScriptTestBlock3")

    check(matches1.len() == 1, "find test block 1")
    check(matches2.len() == 1, "find test block 2")
    check(matches3.len() == 1, "find test block 3")

    const b1 = matches1[0]
    const b2 = matches2[0]
    const b3 = matches3[0]

    blocks: basket = [b1, b2, b3]

    check(blocks.len() == 3, "test block basket")

    check(b1.id > 0, "test block 1 has nonzero ID")
    check(b2.id > 0, "test block 2 has nonzero ID")
    check(b3.id > 0, "test block 3 has nonzero ID")

    const ids = {}

    ids[b1.id] = true

    check(
        ids[b2.id] == nil,
        "test block IDs are unique 1"
    )

    ids[b2.id] = true

    check(
        ids[b3.id] == nil,
        "test block IDs are unique 2"
    )

    ids[b3.id] = true

    const all_blocks = getAllCellsOfClass("Block")

    check(
        all_blocks.len() >= 3,
        "getAllCellsOfClass returns Blocks"
    )

    const original_color = {}
    const original_visible = {}
    const original_solid = {}
    const original_anchored = {}
    const original_offset = {}

    for block in blocks {
        original_color[block.id] = block.color
        original_visible[block.id] = block.visible
        original_solid[block.id] = block.solid
        original_anchored[block.id] = block.anchored
        original_offset[block.id] = block.offset
    }

    for block in blocks {
        block.color = [1, 0, 0]
        block.visible = false
        block.offset = [0, 2, 0]
    }

    for block in blocks {
        check(
            block.visible == false,
            "runtime visible override"
        )

        check(
            block.color[0] == 1,
            "runtime color red"
        )

        check(
            block.color[1] == 0,
            "runtime color green"
        )

        check(
            block.color[2] == 0,
            "runtime color blue"
        )

        check(
            block.offset[1] == 2,
            "runtime offset override"
        )
    }

    const target = b1
    const original_target_solid = target.solid
    const original_target_anchored = target.anchored

    target.solid = false

    check(
        target.solid == false,
        "runtime solid override"
    )

    target.solid = original_target_solid

    if original_target_anchored {
        target.anchored = false
    } else {
        target.anchored = true
    }

    if target.anchored == original_target_anchored {
        check(
            false,
            "runtime anchored override"
        )
    } else {
        check(
            true,
            "runtime anchored override"
        )
    }

    target.anchored = original_target_anchored

    for block in blocks {
        block.color = original_color[block.id]
        block.visible = original_visible[block.id]
        block.solid = original_solid[block.id]
        block.anchored = original_anchored[block.id]
        block.offset = original_offset[block.id]
    }

    for block in blocks {
        check(
            block.visible == original_visible[block.id],
            "runtime visible restore"
        )

        check(
            block.solid == original_solid[block.id],
            "runtime solid restore"
        )

        check(
            block.anchored == original_anchored[block.id],
            "runtime anchored restore"
        )

        if block.offset[0] == original_offset[block.id][0] {
            if block.offset[1] == original_offset[block.id][1] {
                if block.offset[2] == original_offset[block.id][2] {
                    check(true, "runtime offset restore")
                } else {
                    check(false, "runtime offset restore")
                }
            } else {
                check(false, "runtime offset restore")
            }
        } else {
            check(false, "runtime offset restore")
        }

        if block.color[0] == original_color[block.id][0] {
            if block.color[1] == original_color[block.id][1] {
                if block.color[2] == original_color[block.id][2] {
                    check(true, "runtime color restore")
                } else {
                    check(false, "runtime color restore")
                }
            } else {
                check(false, "runtime color restore")
            }
        } else {
            check(false, "runtime color restore")
        }
    }
}

fn test_wait_and_fiber_state() {
    progress: number = 10

    wait(0.05)

    progress += 5

    check(
        progress == 15,
        "wait preserves function locals"
    )

    total: number = 0

    for i in [1, 2, 3] {
        total += i
        wait(0.01)
    }

    check(
        total == 6,
        "wait preserves loop state"
    )

    wait_test_finished = true
}

fn run_suite() {
    debug.log("================================")
    debug.log("AeoScript integration suite START")

    test_core_language()
    test_maps()
    test_baskets()
    test_math()
    test_strings()
    test_blocks()

    debug.log("AeoScript non-yielding integration tests complete")

    finished = true
}

fn on_ready() {
    run_suite()
}

fn update(dt) {
    update_ticks += 1
	debug.log("UPDATE ENTER")
    if dt >= 0 {
        update_seen = true
    }

    if finished {
        if wait_test_started == false {
            wait_test_started = true
            test_wait_and_fiber_state()
        }

        if wait_test_finished {
            if summary_reported == false {
                summary_reported = true

                if update_seen {
                    debug.log("PASS", "update lifecycle")
                } else {
                    debug.log("FAIL", "update lifecycle")
                }

                debug.log("================================")
                debug.log("AeoScript integration harness finished")
            }
        }
    }
}


}
