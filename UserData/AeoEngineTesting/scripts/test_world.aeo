on run_test() {
    debug.log("[TEST] test_world START")
    ok: bool = true

    const dt = time.delta
    if dt < 0 { ok = false }

    const blocks = getAllCellsOfClass("Block")
    if blocks == nil { ok = false }

    const objects = find("NonExistentObjectQuery")
    if objects == nil { ok = false }

    if ok {
        debug.log("[TEST] test_world PASS")
    } else {
        debug.log("[TEST] test_world FAIL")
    }

    test.complete("world", ok)
}
