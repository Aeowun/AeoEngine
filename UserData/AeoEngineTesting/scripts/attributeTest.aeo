debug.log("Test randomiser starting")

const tests = find("Test")
const winner = math.random(0, tests.len() - 1)

for test in tests {
    test.attributes["testBool"] = false
}

tests[winner].attributes["testBool"] = true

debug.log(
    "This block is the winner:",
    tests[winner].attributes["testNum"],
    tests[winner].attributes["Test"]
)