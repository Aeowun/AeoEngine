on PlayerSpawned(player) {
    // 1. Discover all blocks in the scene
    const blocks = getAllCellsOfClass("Block")

    debug.log("DANGER SYSTEM: INITIALIZED ON " + blocks.len() + " BLOCKS")

    while true {
        // 2. Pulse all blocks to Red
        for b in blocks {
            b.color = [1.0, 0.2, 0.2] // [R, G, B]
        }
        wait(0.5)

        // 3. Return to Grey (authored default)
        for b in blocks {
            b.color = [0.5, 0.5, 0.5]
        }
        wait(0.5)
    }
}
