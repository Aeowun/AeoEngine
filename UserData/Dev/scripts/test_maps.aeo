on run_test() {
    debug.log("[TEST] test_maps START")
    ok: bool = true

    const m = {}
    m["key"] = "value"
    m[1] = "numeric"

    if m["key"] != "value" { ok = false }
    if m[1] != "numeric" { ok = false }
    if m["missing"] != nil { ok = false }

    m["key"] = nil
    if m["key"] != nil { ok = false }

    if ok {
        debug.log("[TEST] test_maps PASS")
    } else {
        debug.log("[TEST] test_maps FAIL")
    }

    test.complete("maps", ok)
}
