const hud_width = 220
const hud_height = 76
const hud_margin = 20

const hud_panel = ui.new("Panel")
const health_text = ui.new("Text")
const gold_text = ui.new("Text")

health = 100
gold = 0

fn update_hud() {
    const viewport = ui.get_viewport_size()
    const hud_y = viewport[1] - hud_height - hud_margin - 150

    hud_panel.position = [
        hud_margin,
        hud_y
    ]

    health_text.position = [
        hud_margin + 14,
        hud_y + 14
    ]

    gold_text.position = [
        hud_margin + 14,
        hud_y + 42
    ]

    health_text.text = "HEALTH: " + health
    gold_text.text = "GOLD: " + gold
}

hud_panel.size = [hud_width, hud_height]
hud_panel.color = [0.05, 0.05, 0.05, 0.80]

health_text.color = [1.0, 1.0, 1.0, 1.0]
gold_text.color = [1.0, 0.85, 0.25, 1.0]

update_hud()

on on_damage(amount) {
    health = math.max(0, health - amount)
    update_hud()
}

on on_gold(amount) {
    gold += amount
    update_hud()
}