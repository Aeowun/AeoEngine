on run_test() {
    debug.log("[TEST] test_lights START")
    ok: bool = true

    const light = cell.new("Light")
    if light == nil {
        ok = false
    } else {
        const id = light.id
        light.enabled = true
        if light.enabled != true { ok = false }

        light.enabled = false
        if light.enabled != false { ok = false }

        light.color = [1, 0.5, 0]

        cell.delete(light)
    }

    if ok {
        debug.log("[TEST] test_lights PASS")
    } else {
        debug.log("[TEST] test_lights FAIL")
    }

    test.complete("lights", ok)
}
