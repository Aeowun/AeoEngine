// TRAPS
//
// Every object named "Trap" becomes a damage source.
//
// on_touch is a PLAYER touch event.
// The callback argument c is the Trap cell that was touched.

const traps = find("Trap")

for trap in traps {

    trap.on_touch = fn(c) {
        const player = get_entity("Player")

        if !player.is_valid() || !player.alive {
            return
        }

        // Presentation event.
        event.fire("on_hurt")

        // Gameplay event.
        event.fire("on_damage", 10)
    }
}