on run_test() {
    debug.log("[TEST] test_callbacks START")
    ok: bool = true

    called: bool = false
    const temp = cell.new("Block")
    if temp != nil {
        const callback = fn(other) {
            called = true
        }
        temp.on_touch = callback
        callback(temp)
        if !called {
            ok = false
        }
        cell.delete(temp)
    } else {
        ok = false
    }

    if ok {
        debug.log("[TEST] test_callbacks PASS")
    } else {
        debug.log("[TEST] test_callbacks FAIL")
    }

    test.complete("callbacks", ok)
}
