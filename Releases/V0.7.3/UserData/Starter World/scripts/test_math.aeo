on run_test() {
    debug.log("[TEST] test_math START")
    ok: bool = true

    if math.abs(-5) != 5 { ok = false }
    if math.min(10, 20) != 10 { ok = false }
    if math.max(10, 20) != 20 { ok = false }
    if math.floor(3.7) != 3 { ok = false }
    if math.ceil(3.2) != 4 { ok = false }
    if math.round(3.6) != 4 { ok = false }
    if math.sqrt(16) != 4 { ok = false }
    if math.pow(2, 3) != 8 { ok = false }
    if math.clamp(15, 0, 10) != 10 { ok = false }
    if math.lerp(0, 10, 0.5) != 5 { ok = false }

    const rnd = math.random()
    if rnd < 0 || rnd > 1 { ok = false }

    const roll = math.random(1, 6)
    if roll < 1 || roll > 6 { ok = false }

    if ok {
        debug.log("[TEST] test_math PASS <EASTER EGG AT RUN #4>")
    } else {
        debug.log("[TEST] test_math FAIL")
    }

    test.complete("math", ok)
}
