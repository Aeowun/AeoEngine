fn delayed_value() {
    wait(0.05)
    return 42
}

on run_test() {
    debug.log("[TEST] test_wait START")
    ok: bool = true

    state: number = 0
    state = 1
    wait(0.05)
    state = 2
    if state != 2 { ok = false }

    const val = delayed_value()
    if val != 42 { ok = false }

    counter: number = 0
    for i in [1, 2, 3] {
        wait(0.02)
        counter = counter + i
    }
    if counter != 6 { ok = false }

    if ok {
        debug.log("[TEST] test_wait PASS")
    } else {
        debug.log("[TEST] test_wait FAIL")
    }

    test.complete("wait", ok)
}
