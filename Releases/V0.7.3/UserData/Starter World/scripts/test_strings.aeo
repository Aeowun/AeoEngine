on run_test() {
    debug.log("[TEST] test_strings START")
    ok: bool = true

    const s = "Hello World"
    if string.len(s) != 11 { ok = false }
    if string.lower(s) != "hello world" { ok = false }
    if string.upper(s) != "HELLO WORLD" { ok = false }
    if string.reverse("abc") != "cba" { ok = false }

    const parts = string.split("a,b,c", ",")
    if basket.len(parts) != 3 { ok = false }
    if parts[0] != "a" { ok = false }

    if ok {
        debug.log("[TEST] test_strings PASS")
    } else {
        debug.log("[TEST] test_strings FAIL")
    }

    test.complete("strings", ok)
}
